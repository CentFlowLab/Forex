# =============================================================================
# GROK FOREX AI — Environment template
# Copy this file to .env and fill in credentials. Never commit .env.
# =============================================================================

# --- Application ---
APP_NAME=GROK FOREX AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/grokforex.db
LOG_LEVEL=INFO

# --- Trading environment: BACKTEST | PAPER | LIVE ---
TRADING_ENVIRONMENT=PAPER

# LIVE trading is disabled unless ALL of the following are true:
# 1) LIVE_TRADING_ENABLED=true
# 2) LIVE_MANUAL_AUTHORIZATION=I_AUTHORIZE_LIVE_TRADING
# 3) A real broker adapter is configured with separate credentials
# 4) Pre-trade validation succeeds
LIVE_TRADING_ENABLED=false
LIVE_MANUAL_AUTHORIZATION=
# Hard lock for this development phase (keep true).
LIVE_TRADING_LOCKED=true

# AI spending limits (USD, estimated)
AI_DAILY_BUDGET_USD=5.0
AI_SESSION_BUDGET_USD=2.0
# Robô: análises OpenAI autónomas (observação, sem ordens)
ROBOT_OPENAI_INTERVAL_SECONDS=900
ROBOT_OPENAI_DAILY_BUDGET_USD=0.10

# Max Dukascopy download window per request
DUKASCOPY_MAX_DAYS=14

# --- Risk defaults (conservative testing) ---
MAX_RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_CONCURRENT_POSITIONS=1
MAX_SPREAD_PIPS=2.0
MAX_SLIPPAGE_PIPS=1.5
KILL_SWITCH=false
STALE_DATA_SECONDS=30
STARTING_EQUITY=10000.0
ACCOUNT_CURRENCY=USD

# --- Simulated broker ---
SIM_SPREAD_PIPS=1.2
SIM_COMMISSION_PER_LOT=7.0
SIM_EXECUTION_DELAY_MS=150
SIM_SLIPPAGE_PIPS=0.3

# --- AI providers (leave empty to disable that provider) ---
# Never log these values.
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_DEFAULT_MODEL=grok-4-latest

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Per-agent overrides: PROVIDER:MODEL  e.g. xai:grok-4-latest
AGENT_TECHNICAL_MODEL=
AGENT_TREND_MODEL=
AGENT_FUNDAMENTAL_MODEL=
AGENT_STRATEGY_MODEL=
AGENT_RISK_CHALLENGER_MODEL=
AGENT_COORDINATOR_MODEL=
AGENT_BULL_RESEARCHER_MODEL=
AGENT_BEAR_RESEARCHER_MODEL=

# Pipeline TradingAgents (debate)
DEFAULT_ANALYSIS_WORKFLOW=tradingagents
MAX_DEBATE_ROUNDS=2
MAX_ANALYSIS_DURATION_SECONDS=180
AI_MAX_RETRIES=3

AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.2

# --- IG Markets (LIVE / PAPER scaffolding — not used unless configured) ---
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACC_TYPE=DEMO
IG_API_BASE=

# --- MetaTrader 5 (scaffolding — requires local MT5 terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Optional economic calendar / news (fundamental agent) ---
NEWS_API_KEY=
NEWS_API_BASE=
